{
  "manifest_version": 3,
  "name": "RightMate",
  "version": "2.4.9",
  "description": "Right-click images to convert or upscale, or right-click videos to download them — powered by self-hosted AI backend.",
  "permissions": [
    "contextMenus",
    "downloads",
    "activeTab",
    "scripting",
    "storage",
    "notifications",
    "offscreen",
    "webRequest",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "scripts/content.js"
      ]
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "scripts/youtube-fab.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://drive.google.com/*"
      ],
      "js": [
        "scripts/drive-downloader.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "pages/popup.html" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "options_page": "pages/settings.html",
  "icons": {
    "16": "icons/Anypng.png",
    "48": "icons/Anypng.png",
    "128": "icons/Anypng.png"
  },
  "web_accessible_resources": [
    { "resources": ["pages/offscreen.html", "scripts/offscreen.js"], "matches": ["<all_urls>"] }
  ]
}
