{
  "manifest_version": 3,
  "name": "AnyPNG",
  "version": "2.2.4",
  "description": "Right-click any image to convert, upscale, or remove watermarks — powered by self-hosted AI backend.",
  "permissions": [
    "contextMenus",
    "downloads",
    "activeTab",
    "scripting",
    "storage",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "scripts/content.js"
      ]
    }
  ],
  "action": { "default_popup": "pages/popup.html" },
  "options_page": "pages/settings.html",
  "icons": {
    "16": "icons/Anypng.png",
    "48": "icons/Anypng.png",
    "128": "icons/Anypng.png"
  },
  "web_accessible_resources": [
    { "resources": ["pages/offscreen.html", "scripts/offscreen.js"], "matches": ["<all_urls>"] }
  ]
}