# Required for credit authorization. Never expose the service-role key to the extension.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
INPAINT_PERMIT_SECRET=generate-a-long-random-secret

# Licensing. LICENSE_TOKEN_SECRET signs the entitlement tokens the extension
# caches; rotating it forces every device to re-check its license.
LICENSE_TOKEN_SECRET=generate-a-long-random-secret
# How long a cached entitlement is trusted (also the offline grace period).
# LICENSE_TOKEN_TTL_SECONDS=86400
# Hours before a key may be moved to another device again.
# LICENSE_SWITCH_COOLDOWN_HOURS=24
# Shown to users who have no key yet.
# LICENSE_PURCHASE_URL=https://example.com/buy
# Set once a payment provider is wired into POST /license/webhook/{provider}.
# LICENSE_WEBHOOK_SECRET=
# The static SECRET_TOKEN ships inside the extension, so it is public. Set to 1
# only if a non-extension client still needs the old bearer-token path.
# ALLOW_LEGACY_SERVICE_TOKEN=0

# YouTube downloads (all optional)
# Netscape cookies file from a logged-in throwaway YouTube account; helps when YouTube
# shows "Sign in to confirm you're not a bot" to the server's IP.
# YTDLP_COOKIES_FILE=/app/cookies/cookies.txt
# Override yt-dlp's YouTube player clients if downloads start failing, e.g. default,tv
# YTDLP_PLAYER_CLIENTS=
# Max simultaneous downloads on this server.
# YT_MAX_CONCURRENT=2
# Seconds before finished/unfetched downloads are deleted.
# YT_JOB_TTL_SECONDS=1800
