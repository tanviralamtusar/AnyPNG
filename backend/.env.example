# --- Required -----------------------------------------------------------------
# Supabase project. Never expose the service-role key to the extension: only the
# anon key and per-user JWTs belong on the client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret API key (sb_secret_…, Settings → API Keys). The /auth/* proxy uses it so
# it can send Sb-Forwarded-For; also enable Authentication → Rate Limits →
# "IP Address Forwarding". Without both, every user shares this server's IP for
# Supabase's sign-in/sign-up/refresh rate limits (30–150 requests per 5 minutes).
SUPABASE_SECRET_KEY=

# Ed25519 private key that signs the entitlement tokens the extension caches.
# Its public half is pinned in the extension (RM_LICENSE_PUBLIC_KEY in
# extension/scripts/license.js and offscreen.js), so rotating it means shipping
# a new extension build too. Generate a pair with:
#   python backend/generate_license_keypair.py
LICENSE_SIGNING_KEY=

# Only verifies the older HMAC tokens during the switch to LICENSE_SIGNING_KEY.
# Remove it once LICENSE_TOKEN_TTL_SECONDS (24h) has passed after deploying.
LICENSE_TOKEN_SECRET=

# Admin token: guards /license/admin/* and the /admin panel. Rotate this — the
# pre-2.4.20 extension shipped the old value publicly.
SECRET_TOKEN=

# Sign-in for the /admin panel. The panel stays locked while either is empty.
# Sessions are signed with SECRET_TOKEN, so rotating it signs everyone out.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# ADMIN_SESSION_TTL_SECONDS=43200

# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Licensing (optional) -----------------------------------------------------
# How long a cached entitlement is trusted (also the extension's offline grace period).
# LICENSE_TOKEN_TTL_SECONDS=86400
# Hours before a key may be moved to another device again.
# LICENSE_SWITCH_COOLDOWN_HOURS=24
# Shown to users who have no key yet.
# LICENSE_PURCHASE_URL=https://example.com/buy
# Set once a payment provider is wired into POST /license/webhook/{provider}.
# That endpoint stays disabled (501) while this is empty.
# LICENSE_WEBHOOK_SECRET=

# --- AI image work ------------------------------------------------------------
# Express mode: an API key alone. Otherwise set the project and use ADC.
# VERTEX_API_KEY=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# --- YouTube downloads (all optional) -----------------------------------------
# Netscape cookies file from a logged-in throwaway YouTube account; helps when YouTube
# shows "Sign in to confirm you're not a bot" to the server's IP. Only affects the
# server-side fallback path — the default browser relay never touches the server's IP.
# YTDLP_COOKIES_FILE=/app/cookies/cookies.txt
# Override yt-dlp's YouTube player clients if downloads start failing, e.g. default,tv
# YTDLP_PLAYER_CLIENTS=
# Max simultaneous downloads on this server.
# YT_MAX_CONCURRENT=2
# Seconds before finished/unfetched downloads are deleted.
# YT_JOB_TTL_SECONDS=1800

# --- Legacy / unused ----------------------------------------------------------
# Both relate to code the shipped extension no longer calls (see "Dead code" in
# CLAUDE.md). Leave them unset unless you revive those paths.
# INPAINT_PERMIT_SECRET=
# ALLOW_LEGACY_SERVICE_TOKEN=0
